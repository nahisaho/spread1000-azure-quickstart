# Environment file template for EHR-NLP RAG quickstart.
# Copy to `.env` at the quickstart root and fill in.
# The `.env` file MUST NOT be committed — .gitignore excludes it.

# --- Required (set by user) ---
LOCATION=japaneast
RG=spread1000-ehr-nlp
UNIQUE_SUFFIX=REPLACE_ME_6HEX          # Generate with: openssl rand -hex 3

# --- Chat model (REQUIRED — deploy.sh aborts if CHAT_MODEL_VERSION is empty) ---
# Discover the current GA version for your region with:
#   az cognitiveservices model list -l "$LOCATION" \
#     --query "[?model.name=='gpt-4o' && model.lifecycleStatus=='generallyAvailable' && (model.deprecation.inference==null || model.deprecation.inference > '2026-12-31')].model.version" \
#     -o tsv | sort -r | head -1
CHAT_MODEL_NAME=gpt-4o
CHAT_MODEL_VERSION=REPLACE_ME          # e.g. 2025-XX-XX (verify with the command above)

# --- Tags ---
PROJECT_TAG=spread1000
SCENARIO_TAG=ehr-nlp
PI_TAG=REPLACE_ME_yamada-taro

# --- Auto-populated by 02-provision.md (do not edit by hand) ---
# OPENAI_ENDPOINT=...
# OPENAI_NAME=...
# SEARCH_ENDPOINT=...
# SEARCH_NAME=...
# STORAGE_ACCOUNT=...
# DOCS_CONTAINER=documents
# OPENAI_GPT_DEPLOYMENT=gpt-4o
# OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large
# SEARCH_INDEX=ehr-notes
