# Environment file template for EHR-NLP RAG quickstart.
# Copy to `.env` at the quickstart root and fill in.
# The `.env` file MUST NOT be committed — .gitignore excludes it.

# --- Required (set by user) ---
LOCATION=japaneast
RG=spread1000-ehr-nlp
UNIQUE_SUFFIX=REPLACE_ME_6HEX          # Generate with: openssl rand -hex 3

# --- Tags ---
PROJECT_TAG=spread1000
SCENARIO_TAG=ehr-nlp
PI_TAG=REPLACE_ME_yamada-taro

