# Document Intelligence
# Endpoint generated by infra/deploy.sh (disableLocalAuth: true — no key needed)
AZURE_DOCINT_ENDPOINT=https://<your-docint>.cognitiveservices.azure.com/

# Azure OpenAI
# Endpoint and deployment generated by infra/deploy.sh
AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Authentication: DefaultAzureCredential picks up automatically from:
#   - `az login` (interactive)
#   - AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_CLIENT_SECRET (service principal)
#   - Managed Identity (when running on Azure)
# Do NOT add AZURE_DOCINT_KEY or AZURE_OPENAI_KEY here.

