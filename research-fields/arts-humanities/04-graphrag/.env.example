# === Azure OpenAI (Chat: GPT-4o / GPT-4o-mini 推奨) ===
GRAPHRAG_API_KEY=your_aoai_key_here
GRAPHRAG_API_BASE=https://YOUR-AOAI.openai.azure.com
GRAPHRAG_API_VERSION=2024-10-21

# Chat model deployment name (Azure OpenAI Studio でデプロイした名前)
GRAPHRAG_LLM_MODEL=gpt-4o-mini
GRAPHRAG_LLM_DEPLOYMENT_NAME=gpt-4o-mini

# Embedding model deployment name
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small
GRAPHRAG_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
