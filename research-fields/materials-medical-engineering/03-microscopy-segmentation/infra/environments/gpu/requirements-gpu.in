# requirements-gpu.in — top-level GPU constraints for 03-microscopy-segmentation
#
# Generate the hash-pinned lockfile with:
#   pip install pip-tools
#   pip-compile --generate-hashes \
#     --output-file=requirements-gpu.lock \
#     requirements-gpu.in
#
# Then install reproducibly with:
#   pip install --require-hashes -r requirements-gpu.lock
#
# NOTE: torch/torchvision are pre-installed in the MCR base image.
# Pin exact versions here to ensure reproducibility inside the image.

