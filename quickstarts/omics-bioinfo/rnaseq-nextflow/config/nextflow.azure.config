// Nextflow 設定ファイル (Azure Batch executor)
// 使い方: nextflow run ... -c <(envsubst < nextflow.azure.config)
//
// 必要な環境変数:
//   AZURE_LOCATION                    例: japaneast
//   AZURE_BATCH_ACCOUNT               例: batspread1000rnaseqtanaka
//   AZURE_STORAGE_ACCOUNT             例: stspread1000rnaseqtanaka
//
// 認証モデル:
//   - Controller VM の system-assigned MI で Batch と Storage に認証
//   - Batch node は Controller が発行する短期 SAS で Blob にアクセス
//     (プールに UAMI を付ける方式は Fusion 使用時など高度な用途向け、本テンプレートでは不使用)
//
// nf-azure plugin バージョン: 1.23.1 (Nextflow 26.04.6 に対応)

plugins {
    id 'nf-azure@1.23.1'
}

// ---- Executor ----
process {
    executor = 'azurebatch'

    // 既定 SKU (autoscale で選択される)
    machineType = 'Standard_D*ds_v5,Standard_E*ds_v5'

    // OOM / signal 系エラーは再試行
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'terminate' }
    maxRetries = 2
}

// ---- Blob をワーキングディレクトリに使用 ----
workDir = 'az://omics/nf-work'

// ---- Azure 認証と Batch 設定 ----
azure {
    // Controller VM の system-assigned MI で認証
    managedIdentity {
        system = true
    }

    storage {
        accountName = "${AZURE_STORAGE_ACCOUNT}"
        // 長時間ワークフロー用に SAS トークン期限を 96 時間に延長
        // (48h 既定では 2 日以上のパイプラインで期限切れになる)
        tokenDuration = '96h'
    }

    batch {
        location = "${AZURE_LOCATION}"
        accountName = "${AZURE_BATCH_ACCOUNT}"

        // Nextflow が Batch プールを自動作成・削除する
        autoPoolMode = true
        allowPoolCreation = true

        // 完了時にジョブとプールを削除して課金停止
        deleteJobsOnCompletion = true
        deletePoolsOnCompletion = true

        pools {
            auto {
                autoScale = true
                vmCount = 1
                maxVmCount = 10
                // lowPriority = true  // ← Spot を使う場合はコメント解除
            }
        }
    }
}

// ---- 実行時のレポート ----
// nf-core/rnaseq は既定で ${params.outdir}/pipeline_info/ 配下に
// execution_report_<timestamp>.html / execution_timeline_*.html / execution_trace_*.txt を出力する。
// ここで file を上書きすると run 間で上書きされてしまうため、既定に任せる。
